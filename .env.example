# VITE_WHATSAPP_NUMBER: the studio's WhatsApp number in international format
# (digits only, e.g. 6281234567890 - Indonesian 0812... becomes 62812...).
# REQUIRED in production: if it is empty, WhatsApp buttons open without a
# preset recipient instead of messaging a made-up number.
VITE_WHATSAPP_NUMBER=""

# VITE_SUPABASE_URL: Supabase project API URL (safe to expose to the client).
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# VITE_SUPABASE_ANON_KEY: Supabase anonymous/publishable key (safe to expose
# to the client - all real access control is enforced by Row Level Security
# policies in the database, not by keeping this key secret).
VITE_SUPABASE_ANON_KEY="your-anon-key"

# VITE_UPLOAD_API_URL: only needed if the (currently disabled) Cloudflare R2
# upload Worker is re-enabled. Leave EMPTY otherwise.
VITE_UPLOAD_API_URL=""

# VITE_SENTRY_DSN: enables error monitoring (https://lutfi-qk.sentry.io,
# project "sipastel"). Leave EMPTY to disable Sentry entirely (e.g. local
# development) - the self-hosted error log in Settings > Log Error Sistem
# keeps working either way.
VITE_SENTRY_DSN="https://b2178b38a694518ebdd196f147458fee@o4512133270208512.ingest.de.sentry.io/4512134961561680"

# VITE_APP_VERSION: tags Sentry events with the deploy they came from, e.g.
# the git commit SHA. CI sets this automatically (see deploy.yml); optional
# for local development.
VITE_APP_VERSION=""

# SENTRY_AUTH_TOKEN (build-time only, NOT prefixed with VITE_ - never sent to
# the browser): optional. When set, the build uploads source maps to Sentry
# so stack traces show your real source instead of minified bundle code.
# Create one at https://lutfi-qk.sentry.io/settings/auth-tokens with scopes
# project:releases and org:read, then add it as a secret (never commit it).
# Leave unset to skip source map upload - error capture still works fine
# without it, just with minified stack traces.
SENTRY_AUTH_TOKEN=""
